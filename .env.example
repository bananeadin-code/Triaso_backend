# Copia este archivo como .env y rellena los valores reales
PORT=4000

# MongoDB (local o MongoDB Atlas para producción)
MONGODB_URI=mongodb://127.0.0.1:27017/triaso

# Clave para firmar los JWT (usa una cadena larga y aleatoria)
JWT_SECRET=cambia_esto_por_una_clave_larga_y_secreta

# Origen permitido del frontend (CORS)
FRONTEND_URL=http://localhost:5173

# Correo Gmail oficial de Triaso para enviar ordenes de compra (semana 3)
GMAIL_USER=
GMAIL_APP_PASSWORD=
